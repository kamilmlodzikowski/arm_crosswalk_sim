<?xml version="1.0"?>
<!--
  Sidewalk delivery robot (Starship-like silhouette, simplified).
  Drive: differential drive (2 driven middle wheels + 2 hidden frictionless casters,
         the 4 corner wheels are decorative).
  Sensors: forward RGB camera, 3D lidar on a short mast (16 channels, +-15 deg,
           Velodyne VLP-16-like), IMU.

  Gazebo topics (bridged to ROS 2 by crosswalk_sim):
    /cmd_vel  /odom  /odom/tf (-> /tf, odom->base_footprint)  /joint_states
    /camera/image_raw  /camera/camera_info  /imu
    /lidar (-> ROS /scan, middle ring as a 2D LaserScan)  /lidar/points (-> ROS /lidar/points)
-->
<robot name="delivery_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Arguments ===================== -->
  <xacro:arg name="camera_width" default="640"/>
  <xacro:arg name="camera_height" default="480"/>
  <xacro:arg name="camera_fps" default="15"/>
  <xacro:arg name="camera_hfov" default="1.40"/>
  <xacro:arg name="camera_pitch" default="0.0"/>
  <xacro:arg name="lidar_samples" default="900"/>
  <xacro:arg name="lidar_range" default="30.0"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <xacro:arg name="lidar_vertical_samples" default="16"/>
  <xacro:arg name="lidar_vertical_fov" default="0.5236"/>
  <xacro:arg name="max_linear_velocity" default="1.6"/>
  <xacro:arg name="max_angular_velocity" default="2.0"/>

  <!-- ===================== Dimensions ===================== -->
  <xacro:property name="PI" value="3.14159265358979"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.06"/>
  <xacro:property name="wheel_y" value="0.29"/>
  <xacro:property name="body_l" value="0.70"/>
  <xacro:property name="body_w" value="0.50"/>
  <xacro:property name="body_h" value="0.40"/>
  <!-- body bottom is 0.08 m above ground; base_link sits at wheel axle height -->
  <xacro:property name="body_z" value="${0.08 + body_h/2 - wheel_radius}"/>
  <xacro:property name="body_top" value="${0.08 + body_h - wheel_radius}"/>
  <xacro:property name="caster_r" value="0.04"/>

  <!-- ===================== Materials ===================== -->
  <material name="shell"><color rgba="0.93 0.93 0.92 1"/></material>
  <material name="lid"><color rgba="0.20 0.20 0.22 1"/></material>
  <material name="accent"><color rgba="1.0 0.45 0.05 1"/></material>
  <material name="rubber"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="sensor"><color rgba="0.05 0.05 0.08 1"/></material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <!-- ===================== Links ===================== -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <!-- shell -->
    <visual name="shell">
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
      <material name="shell"/>
    </visual>
    <!-- orange accent band -->
    <visual name="band">
      <origin xyz="0 0 ${body_top - 0.07}"/>
      <geometry><box size="${body_l + 0.006} ${body_w + 0.006} 0.035"/></geometry>
      <material name="accent"/>
    </visual>
    <!-- cargo lid -->
    <visual name="lid">
      <origin xyz="-0.02 0 ${body_top + 0.01}"/>
      <geometry><box size="${body_l - 0.10} ${body_w - 0.06} 0.02"/></geometry>
      <material name="lid"/>
    </visual>
    <!-- decorative corner wheels (no collision) -->
    <xacro:macro name="deco_wheel" params="name x y">
      <visual name="${name}">
        <origin xyz="${x} ${y} 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
    </xacro:macro>
    <xacro:deco_wheel name="deco_fl" x="0.25" y="${wheel_y}"/>
    <xacro:deco_wheel name="deco_fr" x="0.25" y="${-wheel_y}"/>
    <xacro:deco_wheel name="deco_rl" x="-0.25" y="${wheel_y}"/>
    <xacro:deco_wheel name="deco_rr" x="-0.25" y="${-wheel_y}"/>

    <collision>
      <origin xyz="0 0 ${body_z}"/>
      <geometry><box size="${body_l} ${body_w} ${body_h}"/></geometry>
    </collision>
    <!-- hidden casters -->
    <collision>
      <origin xyz="0.27 0 ${caster_r - wheel_radius}"/>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <collision>
      <origin xyz="-0.27 0 ${caster_r - wheel_radius}"/>
      <geometry><sphere radius="${caster_r}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${body_z}"/>
      <mass value="22.0"/>
      <xacro:box_inertia m="22.0" x="${body_l}" y="${body_w}" z="${body_h}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <!-- frictionless casters (applies to all base_link collisions) -->
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- ===================== Driven wheels ===================== -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="wheel_${side}_link">
      <visual>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="1.2"/>
        <inertia ixx="${1.2*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}" ixy="0" ixz="0"
                 iyy="${1.2*wheel_radius*wheel_radius/2}" iyz="0"
                 izz="${1.2*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"/>
      </inertial>
    </link>
    <joint name="wheel_${side}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${side}_link"/>
      <origin xyz="0 ${y} 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.0"/>
    </joint>
    <gazebo reference="wheel_${side}_link">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>1e6</kp>
      <kd>100</kd>
    </gazebo>
  </xacro:macro>
  <xacro:drive_wheel side="left" y="${wheel_y}"/>
  <xacro:drive_wheel side="right" y="${-wheel_y}"/>

  <!-- ===================== Sensors ===================== -->
  <!-- 3D lidar on a mast: high enough that the -15 deg beams clear the lid -->
  <xacro:property name="lidar_h" value="0.17"/>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.05 0 ${body_top + lidar_h}"/>
  </joint>
  <link name="lidar_link">
    <visual name="puck">
      <geometry><cylinder radius="0.052" length="0.072"/></geometry>
      <material name="sensor"/>
    </visual>
    <visual name="mast">
      <!-- from the lid top (lidar_h - 0.02 below) to the puck bottom (0.036 below) -->
      <origin xyz="0 0 ${-(lidar_h + 0.016) / 2}"/>
      <geometry><cylinder radius="0.018" length="${lidar_h - 0.056}"/></geometry>
      <material name="lid"/>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- forward camera in the front face -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${body_l/2 + 0.012} 0 ${body_top - 0.03}" rpy="0 $(arg camera_pitch) 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.024 0.09 0.035"/></geometry>
      <material name="sensor"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 ${body_z}"/>
  </joint>
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>$(arg camera_fps)</update_rate>
      <topic>/camera/image_raw</topic>
      <gz_frame_id>camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>$(arg camera_hfov)</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip><near>0.05</near><far>150</far></clip>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <update_rate>$(arg lidar_rate)</update_rate>
      <topic>/lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>$(arg lidar_samples)</samples>
            <resolution>1</resolution>
            <min_angle>${-PI}</min_angle>
            <max_angle>${PI - 2*PI/$(arg lidar_samples)}</max_angle>
          </horizontal>
          <vertical>
            <samples>$(arg lidar_vertical_samples)</samples>
            <resolution>1</resolution>
            <min_angle>${-$(arg lidar_vertical_fov)/2 if $(arg lidar_vertical_samples) > 1 else 0.0}</min_angle>
            <max_angle>${$(arg lidar_vertical_fov)/2 if $(arg lidar_vertical_samples) > 1 else 0.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.12</min>
          <max>$(arg lidar_range)</max>
          <resolution>0.01</resolution>
        </range>
        <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- ===================== Gazebo systems ===================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>${2*wheel_y}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/odom/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_velocity>$(arg max_linear_velocity)</max_linear_velocity>
      <min_linear_velocity>-$(arg max_linear_velocity)</min_linear_velocity>
      <max_angular_velocity>$(arg max_angular_velocity)</max_angular_velocity>
      <min_angular_velocity>-$(arg max_angular_velocity)</min_angular_velocity>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <min_linear_acceleration>-3.0</min_linear_acceleration>
      <max_angular_acceleration>4.0</max_angular_acceleration>
      <min_angular_acceleration>-4.0</min_angular_acceleration>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
    </plugin>
  </gazebo>
</robot>
